# =========================================================================
# HollaEx QA Automation — Environment Configuration Example
# -------------------------------------------------------------------------
# Copy this file to .env and fill in real values for your environment.
# NEVER commit the .env file. NEVER put production credentials here.
# =========================================================================

# Choose which environment the suite is targeting.
# Values: local | testnet | production-readonly
# - local:        HollaEx Kit running locally via Docker (trading enabled with virtual assets)
# - testnet:      Authorized public HollaEx testnet deployment
# - production-readonly: Only public, read-only smoke tests against pro.hollaex.com
HOLLAEX_ENV=production-readonly

# -- Public production API (read-only, no auth needed) ---------------------
# Verified working API base URL: https://api.hollaex.com (NOT api.pro.hollaex.com).
# Discovery: api.pro.hollaex.com DNS-resolves to NXDOMAIN from this environment;
# the live API is served from api.hollaex.com.
PUBLIC_BASE_URL=https://pro.hollaex.com
PUBLIC_API_BASE_URL=https://api.hollaex.com

# -- Local HollaEx Kit (only set when HOLLAEX_ENV=local) ------------------
LOCAL_BASE_URL=http://localhost:8080
LOCAL_API_BASE_URL=http://localhost:8080
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=hollaex
LOCAL_DB_USER=hollaex
LOCAL_DB_PASSWORD=replace-with-secure-password

# -- Authentication fixtures (only used when HOLLAEX_ENV=local) ----------
# Pre-provisioned test accounts with virtual assets. NEVER use real production credentials.
TEST_USER_EMAIL=qa-tester@hollaex-qa.local
TEST_USER_PASSWORD=replace-with-strong-test-password

# Optional secondary user for multi-account / concurrent tests
TEST_USER_2_EMAIL=qa-tester-2@hollaex-qa.local
TEST_USER_2_PASSWORD=replace-with-strong-test-password

# HollaEx Kit API key + secret for admin provisioning of virtual assets
# ONLY for the local or testnet deployment. NEVER for production.
ADMIN_API_KEY=replace-with-local-admin-api-key
ADMIN_API_SECRET=replace-with-local-admin-api-secret

# -- Test execution tuning -----------------------------------------------
# Use parallel workers per Playwright project; sequential=false for integration tests.
INTEGRATION_WORKERS=1
SMOKE_RETRIES=0
CI_RETRIES=2

# API response time budget for public endpoints (milliseconds)
PUBLIC_API_RESPONSE_BUDGET_MS=5000

# Set to true to skip destructive DB tests on shared databases
DB_READ_ONLY=true
